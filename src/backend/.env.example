# Biến môi trường cho backend. Spring Boot KHÔNG tự đọc file này:
# đặt trong Run Configuration của IDE, hoặc set trong terminal trước khi chạy mvn spring-boot:run.
# Không commit giá trị thật (mật khẩu DB, JWT_SECRET) lên Git.

# MongoDB dùng chung của nhóm (Atlas). Để trống = dùng MongoDB local ở localhost:27017.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/film_photography_contest_management_db

# Khóa ký JWT, tối thiểu 32 ký tự. Để trống = khóa ngẫu nhiên, mọi người bị đăng xuất mỗi lần restart backend.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Tài khoản Admin tạo tự động khi DB chưa có Admin. Để trống ADMIN_PASSWORD = sinh ngẫu nhiên và in ra log.
ADMIN_EMAIL=admin@filmcontest.vn
ADMIN_PASSWORD=

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

